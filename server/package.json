{
  "name": "clouddisk-server",
  "version": "1.0.0",
  "private": true,
  "description": "CloudDisk / 云屿 — self-hosted personal cloud drive: REST API, WebDAV and SPA hosting in one Node process.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2"
  }
}
