# Tern configuration — copy to .env and adjust, then `docker compose up -d`.
# All values are optional; the defaults below match docs/API.md.

# ---- Network ---------------------------------------------------------------
# Host port published by docker compose (the container always listens on 8080).
PORT=8080

# ---- Branding --------------------------------------------------------------
# Name shown in the web UI and browser tab.
SERVER_NAME=Tern

# Absolute base URL used to build share links, e.g. https://disk.example.com
# Leave empty to return relative share URLs such as /s/<token>.
PUBLIC_BASE_URL=

# ---- First boot / accounts -------------------------------------------------
# When the users table is empty on first boot an administrator is created from
# these values. They are ignored on subsequent boots.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Allow public self-registration (POST /api/auth/register).
ALLOW_REGISTRATION=false

# Per-user quota in GB; 0 = unlimited.
DEFAULT_QUOTA_GB=0

# ---- Uploads / storage -----------------------------------------------------
# Maximum size of a single upload request in bytes (default 20 GiB).
MAX_UPLOAD_BYTES=21474836480

# SQLite database + file blobs. In Docker this must stay /data (the volume).
DATA_DIR=/data

# Runtime ownership of /data inside the container. The entrypoint fixes volume
# ownership as root, then drops privileges to this UID/GID.
DATA_UID=1000
DATA_GID=1000

# ---- HTTP / security -------------------------------------------------------
# true | false | auto  (auto = Secure cookie only when the request is HTTPS)
COOKIE_SECURE=auto

# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# Container timezone (affects log timestamps and share expiry displays).
TZ=Asia/Shanghai
