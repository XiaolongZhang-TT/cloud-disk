# dependencies
node_modules/
.pnpm-store/

# build output
web/dist/
server/dist/
macos/.build/
macos/build/
web/screenshots/

# Keep the downloadable macOS build in the repo, but not the .app bundle or CLI
macos/dist/*
!macos/dist/Tern-*.zip
!macos/dist/Tern-*.zip.sha256

# runtime data & secrets
data/*
!data/.gitkeep
server/.data/
.env
*.db
*.db-wal
*.db-shm
*.log

# tooling
.npm-cache/
.npm-logs/
.qa/
.DS_Store

# local gh cache used in sandboxed development
.gh-cache/

# Windows client build output
windows/bin/
windows/obj/
windows/dist/
windows/*.user

# Xcode / File Provider build output
macos/.build-xcode/
macos/DerivedData/

# Xcode user state
macos/Tern.xcodeproj/xcuserdata/
macos/Tern.xcodeproj/project.xcworkspace/xcuserdata/
